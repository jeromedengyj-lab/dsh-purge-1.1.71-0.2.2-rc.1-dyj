+// Synchronous counterpart for synchronous shim patching: it guarantees the
+// "back up first, overwrite second" order, and its exceptions are catchable by
+// the caller's ordinary try/catch (an un-awaited async call would not be).
+export function atomicCopyFileSync(src, dst) {
+  nodeFs.mkdirSync(path.dirname(dst), { recursive: true });
+  const tmp = `${dst}.${process.pid}.${Date.now()}.${randomBytes(3).toString("hex")}.copytmp`;
+  try {
+    nodeFs.copyFileSync(src, tmp);
+  } catch (e) {
+    try { nodeFs.unlinkSync(tmp); } catch { /* ignore */ }
+    nodeFs.copyFileSync(src, dst);
+    return;
+  }
+  try {
+    nodeFs.renameSync(tmp, dst);
+  } catch (e) {
+    const code = e && e.code;
+    if (code === "EEXIST" || code === "EPERM" || code === "EACCES" || code === "EBUSY") {
+      try {
+        try { nodeFs.unlinkSync(dst); } catch { /* ignore */ }
+        nodeFs.renameSync(tmp, dst);
+        return;
+      } catch { /* fall through to the plain-copy fallback */ }
+    }
+    try { nodeFs.unlinkSync(tmp); } catch { /* ignore */ }
+    nodeFs.copyFileSync(src, dst);
   }
 }
 
